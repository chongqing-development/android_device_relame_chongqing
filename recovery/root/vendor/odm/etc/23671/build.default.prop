# Bluetooth
bluetooth.device.default_name=realme 11X 5g

# Camera
ro.vendor.oplus.camera.backCamSize=64MP+2MP
ro.vendor.oplus.camera.frontCamSize=8MP

# Cryptoeng
ro.vendor.oplus.attestid.without_meid=true

# NFC
ro.boot.product.hardware.sku=nfc

# Region
persist.sys.oplus.region=US
ro.vendor.oplus.regionmark=EUEX

# RIL
ro.vendor.mtk_c2k_lte_mode=0
ro.vendor.mtk_c2k_support=0
ro.vendor.mtk_md1_support=22
ro.vendor.mtk_protocol1_rat_config=N/Lf/Lt/W/G
ro.vendor.mtk_ps1_rat=N/Lf/Lt/W/G
