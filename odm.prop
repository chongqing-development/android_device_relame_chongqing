# Audio
audio.tuning.def_path=/odm/etc/audio/audio_param/.
persist.vendor.audio.tuning.def_path=/odm/etc/audio/audio_param/.
ro.config.vc_call_vol_steps=9
vendor.audio.powerhal.power.hi_res=true

# Bluetooth
persist.bluetooth.a2dp_aac_abr.enable=false
persist.bluetooth.a2dp.lhdc=false
persist.bluetooth.absvolume_support=true
persist.bluetooth.disableabsvol=false
persist.bluetooth.disableinbandringing=false
persist.bluetooth.specificatcmdsenable=true
persist.bt.iot.enablelogging=true
persist.vendor.bluetooth.btc.tdd.dynamic20=true
persist.vendor.bluetooth.modem_nv_support=true
persist.vendor.bt.iotinfo.report.enable=true
persist.vendor.service.bt.iot.enablelogging=true
persist.vendor.service.bt.iotinfo.report.enable=true

# Camera
ro.camera.hfr.enable=1
ro.camera.notify_nfc=1
ro.camera.temperature.limit=420
ro.camera.videoeis.enable=1
ro.oplus.camera.facing.front.need.disable.nfc=1
ro.vendor.camera3.zsl.default=300
ro.vendor.oplus.camera.isHasselbladCamera=0
ro.vendor.oplus.camera.isSupportExplorer=0

# Debug
persist.sys.mtk.pwkdump=0
persist.sys.powerkeydump=0
persist.sys.assert.enabletip=0
persist.sys.assert.panic=false

# Display
debug.display.cabc.reset=1
persist.oplus.display.vrr=0
persist.oplus.display.vrr.adfr=-1

# Hardware
ro.soc.manufacturer=Mediatek
ro.soc.model=MT6835

# LMKD
ro.lmk.limit_killing_array_kb=2097152,1572864,1468006,665600
ro.lmk.psi_complete_stall_ms=150
ro.lmk.swap_free_low_percentage=20
ro.lmk.swap_is_low_kill_enable=1

# Regional properties
import /odm/etc/${ro.boot.prjname}/build.default.prop

# RIL
persist.vendor.radio.subsys_daemon_support=0
persist.vendor.radio.telecom.vibrate=0
persist.vendor.vonr_setting_support=1
ro.vendor.mtk_eccci_c2k=1
ro.vendor.mtk_irat_support=0
ro.vendor.mtk_lte_support=1
ro.vendor.mtk_md3_support=0

# Sensor
ro.vendor.oplus.sensor.report_brightness=true

# WLAN
persist.debug.wfd.enable=1
